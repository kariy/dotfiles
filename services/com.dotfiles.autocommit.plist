<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.dotfiles.autocommit</string>
	<key>ProgramArguments</key>
	<array>
		<string>__DOTFILE_PATH__/scripts/autocommit-watch.sh</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardOutPath</key>
	<string>/tmp/dotfiles-autocommit.stdout.log</string>
	<key>StandardErrorPath</key>
	<string>/tmp/dotfiles-autocommit.stderr.log</string>
</dict>
</plist>
