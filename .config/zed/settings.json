// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.
{
	"cli_default_open_behavior": "existing_window",
 "agent_servers": {
  "amp-acp": {
   "type": "registry"
  },
  "codex-acp": {
   "type": "registry"
  },
  "claude-acp": {
   "type": "registry"
  }
 },
 "project_panel": {
  "dock": "left"
 },
 "outline_panel": {
  "dock": "right"
 },
 "collaboration_panel": {
  "dock": "right"
 },
 "icon_theme": {
  "mode": "dark",
  "light": "Zed (Default)",
  "dark": "Zed (Default)"
 },
 "git_panel": {
  "dock": "right",
  "tree_view": true
 },
 "ssh_connections": [
  {
   "host": "185.26.9.71",
   "username": "ubuntu",
   "args": [],
   "projects": [
    {
     "paths": [
      "/home/ubuntu/katana"
     ]
    }
   ]
  }
 ],
 "sticky_scroll": {
		"enabled": true,
	},
	"languages": {
		"Rust": {
			"show_edit_predictions": true,
		},
	},
	"base_keymap": "VSCode",
	"telemetry": {
		"diagnostics": false,
		"metrics": false,
	},
	"theme": {
  "mode": "dark",
  "light": "One Light",
  "dark": "Catppuccin Mocha (Blur) [Heavy]"
 },
	"experimental.theme_overrides": {
		"syntax": {},
	},
	"buffer_font_size": 11.5,
	"buffer_line_height": "comfortable",
	"buffer_font_family": "Berkeley Mono",
	"terminal": {
		"font_family": "Berkeley Mono",
		"font_size": 11,
	},
	"relative_line_numbers": "disabled",
	"vim_mode": true,
	"hard_tabs": true,
	"tab_size": 4,
	"inlay_hints": {
		"enabled": false,
		"show_type_hints": true,
		"show_parameter_hints": true,
		"show_other_hints": true,
	},
	"lsp": {
		"rust-analyzer": {
			"rustfmt": { "extraArgs": ["+nightly"] },
		},
	},
	"centered_layout": {
		"left_padding": 0.12,
		"right_padding": 0.09,
	},
	"agent": {
		"dock": "left",
  "provider": {
			"default_model": "claude-3-5-sonnet-20240620",
			"name": "anthropic",
			"type": "anthropic",
		},
	},
}
